pipeline {
    agent any

    environment {
        NODE_OPTIONS = "--max-old-space-size=4096"
        CHROME_BIN = "/usr/bin/google-chrome"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Fetching code from GitHub...'
                git branch: 'marketplace-and-delivery-modules',
                    credentialsId: 'github-credentials',
                    url: 'https://github.com/hafedhhammami6560/CampWay-frontend.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing npm packages...'
                sh 'npm ci'
            }
        }

        stage('Unit Tests') {
            steps {
                echo 'Running Jasmine tests...'
                sh 'ng test --watch=false --browsers=ChromeHeadless --code-coverage'
            }
            post {
                always {
                    junit testResults: 'coverage/junit/*.xml',
                          allowEmptyResults: true
                    archiveArtifacts artifacts: 'coverage/**/*',
                          allowEmptyArchive: true, fingerprint: true
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonar-token-frontend', variable: 'SONAR_TOKEN')]) {
                        sh """
                            sonar-scanner \
                              -Dsonar.projectKey=campway-frontend \
                              -Dsonar.projectName=campway-frontend \
                              -Dsonar.sources=src \
                              -Dsonar.exclusions=**/node_modules/**,**/*.spec.ts,**/coverage/** \
                              -Dsonar.tests=src \
                              -Dsonar.test.inclusions=**/*.spec.ts \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                              -Dsonar.host.url=http://localhost:9000 \
                              -Dsonar.login=\$SONAR_TOKEN
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Build') {
            steps {
                echo 'Building the Angular app...'
                sh 'ng build --configuration production'
            }
            post {
                success {
                    archiveArtifacts artifacts: 'dist/**/*',
                          allowEmptyArchive: true, fingerprint: true
                }
            }
        }
    }

    post {
        success { echo 'Pipeline completed successfully!' }
        failure { echo 'Pipeline failed. Check the logs.' }
        always {
            script {
                try { cleanWs() } catch (err) { echo "Could not clean workspace: ${err.message}" }
            }
        }
    }
}
